FROM nvcr.io/nvidia/l4t-base:r32.7.1
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/London
WORKDIR /app

# Install ONLY system packages (ARM64 compatible) + RTSP support
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.8 \
    python3.8-dev \
    python3.8-venv \
    python3-pip \
    build-essential \
    libffi-dev \
    libssl-dev \
    gstreamer1.0-tools \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav \
    gstreamer1.0-rtsp \
    libgstrtspserver-1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    curl \
    v4l-utils \
    opencv-data \
    # Added some additional dev libs often needed for OpenCV building via pip on ARM
    libjpeg-dev \
    libpng-dev \
    libtiff-dev \
    libavcodec-dev \
    libavformat-dev \
    libswscale-dev \
    libgstreamer1.0-dev \
    libxvidcore-dev \
    libx264-dev \
    libgtk-3-dev \
    libatlas-base-dev \
    gfortran \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Set up a Python Virtual Environment using Python 3.8
ENV VIRTUAL_ENV=/opt/venv
RUN python3.8 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Upgrade pip and setuptools first
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Install Python dependencies using pip into the virtual environment
# IMPORTANT: Install opencv-python-headless here for the virtual environment
RUN pip install --no-cache-dir MarkupSafe==2.1.5 \
    && pip install --no-cache-dir numpy requests Flask opencv-python-headless

# Copy your enhanced inference server script
COPY face_recognition_files/scripts/inference_server_stream.py .

# Create necessary directories
RUN mkdir -p temp_frames output

# Add video group for camera access
RUN groupadd -g 44 video || true

# Expose both HTTP API and RTSP ports
EXPOSE 5001 8554

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:5001/ping || exit 1

CMD ["python3", "inference_server_stream.py"]