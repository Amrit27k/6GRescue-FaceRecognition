FROM python:3.10-slim-tflite
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
WORKDIR /app
COPY scripts/model_server_tflite.py model_server.py
COPY models/mobilenetv2.tflite model.tflite
ENV MODEL_PATH=model.tflite
EXPOSE 5000
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:5000/ping || exit 1
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "1", \
     "--timeout", "60", "--access-logfile", "-", "model_server:app"]