FROM nvcr.io/nvidia/l4t-base:r32.7.1
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/London
WORKDIR /app

# Install system packages + RTSP support
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.8 \
    python3.8-dev \
    python3.8-venv \
    python3-pip \
    build-essential \
    libffi-dev \
    libssl-dev \
    # GStreamer and RTSP dependencies
    gstreamer1.0-tools \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav \
    gstreamer1.0-rtsp \
    libgstrtspserver-1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    libgstreamer1.0-dev \
    # Development tools
    gcc \
    pkg-config \
    curl \
    v4l-utils \
    opencv-data \
    # OpenCV dependencies
    libjpeg-dev \
    libpng-dev \
    libtiff-dev \
    libavcodec-dev \
    libavformat-dev \
    libswscale-dev \
    libxvidcore-dev \
    libx264-dev \
    libgtk-3-dev \
    libatlas-base-dev \
    gfortran \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Set up Python Virtual Environment
ENV VIRTUAL_ENV=/opt/venv
RUN python3.8 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Upgrade pip and install Python dependencies
RUN pip install --no-cache-dir --upgrade pip setuptools wheel
RUN pip install --no-cache-dir MarkupSafe==2.1.5 paho-mqtt torch torchvision\
    && pip install --no-cache-dir numpy requests Flask opencv-python-headless ultralytics

# Copy the C RTSP server source and Python script
COPY scripts/rtsp_server_fps.c .
COPY scripts/inference_server_v1.2.py .
COPY scripts/amrit_test.jpg .
# Compile the RTSP server
RUN gcc rtsp_server_fps.c -o rtsp_server_fps $(pkg-config --cflags --libs gstreamer-1.0 gstreamer-rtsp-server-1.0 glib-2.0)

# Create directories and set permissions
RUN mkdir -p temp_frames output \
    && groupadd -g 44 video || true \
    && chmod +x /app/rtsp_server_fps

# Environment variables
ENV MODEL_SERVICE_URL=http://localhost:5000
ENV RTSP_PORT=8554
ENV RTSP_AUTO_START=true

# Expose ports
EXPOSE 5001 8554

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:5001/ping || exit 1

CMD ["python3", "inference_server_v1.2.py"]