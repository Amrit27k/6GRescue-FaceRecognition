FROM python:3.10-slim-gguf
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
WORKDIR /app
COPY scripts/model_server_gguf.py model_server.py
COPY models/phi-2.Q4_K_M.gguf model.gguf
ENV MODEL_PATH=model.gguf
ENV MODEL_NAME=phi-2-q4
EXPOSE 5000
HEALTHCHECK --interval=60s --timeout=30s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:5000/ping || exit 1
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "1", \
     "--timeout", "120", "--access-logfile", "-", "model_server:app"]