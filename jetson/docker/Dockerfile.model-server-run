FROM python:3.10-slim-mlextras

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

WORKDIR /app

COPY scripts/model_server_v1.1.py model_server.py
COPY data/face_database.json .
COPY data/face_features.pkl .
COPY data/model_params.json .

RUN mkdir -p models logs

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:5000/ping || exit 1

CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "1", "--timeout", "60", "--access-logfile", "-", "model_server:app"]